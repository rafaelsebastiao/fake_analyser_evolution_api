PORT=8080
SERVER_URL="http://localhost:8081"
APPLICATION_NAME="EvolutionAPI"

# Chave que você escolheu
AUTHENTICATION_API_KEY=1234

# Chaves de criptografia obrigatórias para geração do QR Code na v2
CONFIG_SESSION_KEY=evolution
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# Configuração do Postgres
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI="postgresql://evolution:evolution_password@evolution-db:5432/evolution_api?schema=public"



# Chave JWT global para assinar a conexão do QR Code (Pode manter esse padrão)
jwt_secret=L6Yf6fU7YhT6gFd5sR4eE3wQ2qA1zXvB
jwt_expires_in=365d

# Liberação de CORS para o navegador exibir mídias do WSL
CORS_ORIGIN="*"
CORS_METHODS="GET,POST,PUT,DELETE"
CORS_CREDENTIALS=true



# CONFIGURAÇÃO CRUCIAL: Desativando o Redis para sumir o erro dos logs
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true



# CONFIGURAÇÃO CRUCIAL: Sem ela, nao libera o QR-CODE. pesquisar whatsapp versions no navegador e cole a ultima versão (https://wppconnect.io/pt-BR/whatsapp-versions/)
CONFIG_SESSION_PHONE_VERSION="2.3000.1047700797"